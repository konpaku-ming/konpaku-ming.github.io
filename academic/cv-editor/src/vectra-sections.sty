% ---------------------------------------------------------------------------
% Publications
%
% Arguments:
%   1 Prefix
%   2 Authors
%   3 Title
%   4 Venue
%   5 Year
%   6 Location
%   7 Links
%
% Format:
%   [C1] Authors. Title. Venue, Year. Location. [Links]
% ---------------------------------------------------------------------------

\NewDocumentCommand{\VectraPublicationEntry}{mmmmmmm}{%
    \par
    \begingroup
    \setlength{\parindent}{0pt}%
    \hangindent=\dimexpr\VectraPublicationPrefixWidth+\VectraPublicationPrefixSeparation\relax
    \hangafter=1
    \noindent
    \makebox[\VectraPublicationPrefixWidth][l]{%
        \ifblank{#1}{}{[#1]}%
    }%
    \hspace{\VectraPublicationPrefixSeparation}%
    \ignorespaces
    \ifblank{#2}{}{#2. }%
    \ifblank{#3}{}{\textbf{#3}.}%
    \ifblank{#4}{%
        \ifblank{#5}{}{ #5.}%
    }{%
        \space\textit{#4}%
        \ifblank{#5}{}{, #5}%
        .%
    }%
    \ifblank{#6}{}{ #6.}%
    \Vectra@PublicationLinksInline{#7}%
    \par
    \endgroup
    \Vectra@RecordEntryGap
}

\NewDocumentCommand{\VectraPublicationNote}{+m}{%
    \Vectra@OneColumnBlock{%
        {\VectraPublicationNoteFont #1}%
    }%
    \par\vspace{\VectraPublicationNoteBottomSpace}%
    \Vectra@SetLastEntryGap{\VectraPublicationNoteBottomSpace}%
}

% ---------------------------------------------------------------------------
% Talks
%
% Arguments:
%   1 Prefix
%   2 Talk title
%   3 Event, host, seminar, conference, workshop, or venue
%   4 Location
%   5 Links
%   6 Date
%
% Format:
%   [T1] Title. Event, Location. [Links]       Date
% ---------------------------------------------------------------------------

\NewDocumentCommand{\VectraTalkEntry}{mmmmmm}{%
    \Vectra@IndexedTwoColumnBlock{#1}{%
        \ifblank{#2}{}{\textbf{#2}. }%
        \Vectra@BeginCompactFields
        \Vectra@CompactField{#3}{\textit{#3}}%
        \Vectra@CompactField{#4}{#4}%
        \ifVectra@compactfieldprinted
            .%
        \fi
        \Vectra@TalkLinksInline{#5}%
    }{%
        \ifblank{#6}{}{\textit{#6}}%
    }%
    \Vectra@RecordEntryGap
}

% ---------------------------------------------------------------------------
% Media
%
% Arguments:
%   1 Prefix
%   2 Title
