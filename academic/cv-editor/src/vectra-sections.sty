% ---------------------------------------------------------------------------
% Section command
% ---------------------------------------------------------------------------

\NewDocumentCommand{\VectraSection}{m}{%
    \par
    \Vectra@CancelLastEntryGap
    \Vectra@ResetSectionContent
    \section{#1}%
}

% ---------------------------------------------------------------------------
% Group heading commands
% ---------------------------------------------------------------------------

\NewDocumentCommand{\VectraPublicationGroup}{m}{%
    \par
    \Vectra@CancelLastEntryGap
    \ifVectra@sectionhascontent
        \vspace{\VectraPublicationGroupTopSpace}%
    \fi
    \noindent{\VectraPublicationGroupFont #1}%
    \par\vspace{\VectraPublicationGroupBottomSpace}%
    \Vectra@SetLastEntryGap{\VectraPublicationGroupBottomSpace}%
}

\NewDocumentCommand{\VectraTalkGroup}{m}{%
    \par
    \Vectra@CancelLastEntryGap
    \ifVectra@sectionhascontent
        \vspace{\VectraTalkGroupTopSpace}%
    \fi
    \noindent{\VectraTalkGroupFont #1}%
    \par\vspace{\VectraTalkGroupBottomSpace}%
    \Vectra@SetLastEntryGap{\VectraTalkGroupBottomSpace}%
}

\NewDocumentCommand{\VectraMediaGroup}{m}{%
