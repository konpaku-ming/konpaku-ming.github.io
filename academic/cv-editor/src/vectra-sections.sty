%   [M1] Title. Outlet. [Links]       Date
% ---------------------------------------------------------------------------

\NewDocumentCommand{\VectraMediaEntry}{mmmmm}{%
    \Vectra@IndexedTwoColumnBlock{#1}{%
        \ifblank{#2}{}{\textbf{#2}. }%
        \ifblank{#3}{}{\textit{#3}.}%
        \Vectra@MediaLinksInline{#4}%
    }{%
        \ifblank{#5}{}{\textit{#5}}%
    }%
    \Vectra@RecordEntryGap
}

% ---------------------------------------------------------------------------
% Teaching
%
% Arguments:
%   1 Institution
%   2 Course title or teaching activity
%   3 Links
%   4 Term or date
%
% Format:
%   Institution, Course Title. [Links]       Term
% ---------------------------------------------------------------------------

\NewDocumentCommand{\VectraTeachingEntry}{mmmm}{%
    \Vectra@TwoColumnBlock{%
        \ifblank{#4}{}{\textit{#4}}%
    }{%
        \Vectra@BeginEntryLines
        \Vectra@EntryLine{#1}{#1}%
        \ifblank{#2}{}{%
            \ifblank{#1}{}{\unskip,\space}%
            \textbf{#2}.%
        }%
        \Vectra@TeachingLinksInline{#3}%
    }%
    \Vectra@RecordEntryGap
}

\NewDocumentCommand{\VectraTeachingCourseEntry}{mm}{%
    \Vectra@TwoColumnBlock{%
        #2%
    }{%
        \Vectra@BeginEntryLines
        \ifblank{#1}{}{\textbf{#1}}%
    }%
    \Vectra@RecordEntryGap
}

\NewDocumentCommand{\VectraTeachingCourseInstitutionEntry}{mmm}{%
    \Vectra@TwoColumnBlock{%
        #3%
    }{%
        \ifblank{#1}{}{\textbf{#1}}%
        \ifblank{#2}{}{\space\textbar\space #2}%%
    }%
    \Vectra@RecordEntryGap
}

