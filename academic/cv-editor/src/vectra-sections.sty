\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{vectra-sections}[2026/09/14 v1.2.0 Vectra section commands]

\RequirePackage{titlesec}

% ---------------------------------------------------------------------------
% Section formatting
% ---------------------------------------------------------------------------

\titleformat{\section}
    {\needspace{\VectraSectionNeedSpace}\VectraSectionFont}
    {}
    {0pt}
    {}
    [\vspace{\VectraSectionRuleSpace}{\color{VectraRuleColor}\titlerule[\VectraSectionRuleThickness]}]

\titlespacing{\section}
    {0pt}
    {\VectraSectionTopSpace}
    {\VectraSectionBottomSpace}

% ---------------------------------------------------------------------------
% Internal line-building helpers
% ---------------------------------------------------------------------------

\newif\ifVectra@entrylineprinted

\NewDocumentCommand{\Vectra@BeginEntryLines}{}{%
    \Vectra@entrylineprintedfalse
}

\NewDocumentCommand{\Vectra@EntryLine}{m m}{%
    \ifblank{#1}{}{%
        \ifVectra@entrylineprinted
            \VectraEntryBreak
        \fi
        #2%
        \Vectra@entrylineprintedtrue
    }%
}

\NewDocumentCommand{\Vectra@MetaBlock}{m m}{%
    \Vectra@BeginEntryLines
    \Vectra@EntryLine{#1}{#1}%
    \Vectra@EntryLine{#2}{#2}%
}

% ---------------------------------------------------------------------------
% Compact inline field helpers
% ---------------------------------------------------------------------------

\newif\ifVectra@compactfieldprinted

\NewDocumentCommand{\Vectra@BeginCompactFields}{}{%
    \Vectra@compactfieldprintedfalse
}

\NewDocumentCommand{\Vectra@CompactField}{m m}{%
    \ifblank{#1}{}{%
        \ifVectra@compactfieldprinted
            ,\space
        \fi
        #2%
        \Vectra@compactfieldprintedtrue
    }%
}

% ---------------------------------------------------------------------------
% Publication link helpers
% ---------------------------------------------------------------------------

\newif\ifVectra@publicationlinkprinted

\NewDocumentCommand{\VectraPublicationLink}{m m}{%
    \ifblank{#1}{}{%
        \ifVectra@publicationlinkprinted
            \unskip\VectraPublicationLinkSeparator
        \fi
        \ifblank{#2}{[#1]}{[\href{#2}{#1}]}%
        \Vectra@publicationlinkprintedtrue
    }%
    \ignorespaces
}

\NewDocumentCommand{\Vectra@PublicationLinksInline}{+m}{%
    \ifblank{#1}{}{%
        {\VectraPublicationLinkFont
            \Vectra@publicationlinkprintedfalse
            #1\unskip
        }%
    }%
}

