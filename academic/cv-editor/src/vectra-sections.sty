    \Vectra@MajorEntryGap
}

% ---------------------------------------------------------------------------
% Education
%
% Arguments:
%   1 Institution
%   2 Degree or program
%   3 Location
%   4 Date
%
% Location and date may be left empty.
% ---------------------------------------------------------------------------

\NewDocumentCommand{\VectraEducationEntry}{mmmm}{%
    \Vectra@TwoColumnBlock{%
        \Vectra@MetaBlock{#3}{#4}%
    }{%
        \Vectra@BeginEntryLines
        \Vectra@EntryLine{#1}{\textbf{#1}}%
        \Vectra@EntryLine{#2}{#2}%
    }%
    \Vectra@MajorEntryGap
}

\NewDocumentCommand{\VectraEducationEntryDetailed}{mmmmmmm}{%
    \Vectra@TwoColumnBlock{%
        \Vectra@MetaBlock{#3}{#4}%
    }{%
        \leftskip=\VectraEducationLeftIndent
        \Vectra@BeginEntryLines
        \Vectra@EntryLine{#1}{\textbf{#1}}%
        \Vectra@EntryLine{#2}{#2}%
        \Vectra@EntryLine{#5}{#5}%
        \Vectra@EntryLine{#6}{#6}%
    }%
    \vspace{\VectraEducationNoteSeparation}%
    \Vectra@TwoColumnBlock{}{%
        \leftskip=\VectraEducationLeftIndent
        \VectraEntryStrut #7\par
    }%
    \Vectra@MajorEntryGap
}

\NewDocumentCommand{\VectraEducationBulletList}{m m}{%
    \Vectra@CancelLastEntryGap
    \vspace{\VectraEducationBulletTopSpace}%
    \noindent
    \hspace*{\VectraEducationBulletIndent}%
    \makebox[\VectraEducationBulletLabelWidth][l]{\tiny$\bullet$}%
    \VectraEntryStrut #1%
    \ifblank{#2}{%
        \par
    }{%
        \VectraEntryBreak
        \noindent
        \hspace*{\VectraEducationBulletIndent}%
        \makebox[\VectraEducationBulletLabelWidth][l]{\tiny$\bullet$}%
        \VectraEntryStrut #2\par
    }%
    \Vectra@MajorEntryGap
}
% ---------------------------------------------------------------------------
% Research experience
%
% Arguments:
%   1 Institution
%   2 Role
%   3 Location
%   4 Date
%   5 Advisor
%   6 Topics
%   7 Bullet items
%
% Advisor, topics, location, date, and bullets may be left empty.
% ---------------------------------------------------------------------------

\NewDocumentCommand{\VectraResearchExperienceEntry}{mmmmmm +m}{%
    \Vectra@TwoColumnBlock{%
        \Vectra@MetaBlock{#3}{}
    }{%
        \Vectra@BeginEntryLines
        \Vectra@EntryLine{#1}{\textbf{#1}}%
    }%
    \ifblank{#5}{}{%
        \Vectra@TwoColumnBlock{}{%
            \Vectra@BeginEntryLines
            \Vectra@EntryLine{#5}{Advisor: #5}%
        }%
    }%
    \Vectra@TwoColumnBlock{%
        \Vectra@MetaBlock{}{#4}%
    }{%
        \Vectra@BeginEntryLines
        \Vectra@EntryLine{#2}{#2}%
    }%
    \ifblank{#7}{%
        \Vectra@MajorEntryGap
    }{%
        \Vectra@BeforeBullets
        \begin{VectraBullets}
            #7%
        \end{VectraBullets}
        \Vectra@MajorEntryGap
    }%
}

% ---------------------------------------------------------------------------
% General experience
%
% Arguments:
%   1 Organization
%   2 Role
%   3 Location
%   4 Date
%   5 Area, topic, or technologies
%   6 Additional note
%   7 Bullet items
%
% Location, date, area, note, and bullets may be left empty.
% ---------------------------------------------------------------------------

\NewDocumentCommand{\VectraExperienceEntry}{mmmmmm +m}{%
    \Vectra@TwoColumnBlock{%
        \Vectra@MetaBlock{#3}{#4}%
    }{%
        \Vectra@BeginEntryLines
        \Vectra@EntryLine{#1}{\textbf{#1}}%
        \Vectra@EntryLine{#2}{#2}%
        \Vectra@EntryLine{#5}{\textit{#5}}%
        \Vectra@EntryLine{#6}{#6}%
    }%
    \ifblank{#7}{%
        \Vectra@MajorEntryGap
    }{%
        \Vectra@BeforeBullets
        \begin{VectraBullets}
            #7%
        \end{VectraBullets}
        \Vectra@MajorEntryGap
    }%
}

% ---------------------------------------------------------------------------
