\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{vectra-footer}[2026/09/14 v1.2.0 Vectra footer settings]

\RequirePackage{fancyhdr}
\RequirePackage{lastpage}

\newcommand{\Vectra@dateMode}{today}
\newcommand{\Vectra@fixedDate}{}
\newcommand{\Vectra@footerMode}{full}

\newcommand{\VectraSetDateMode}[1]{\renewcommand{\Vectra@dateMode}{#1}}
\newcommand{\VectraSetFixedDate}[1]{\renewcommand{\Vectra@fixedDate}{#1}}
\newcommand{\VectraSetFooterMode}[1]{\renewcommand{\Vectra@footerMode}{#1}}

\NewDocumentCommand{\Vectra@FooterDateText}{}{%
    \ifdefstring{\Vectra@dateMode}{none}{}{%
        \ifdefstring{\Vectra@dateMode}{fixed}{%
            \ifblank{\Vectra@fixedDate}{}{Last updated: \Vectra@fixedDate}%
        }{%
            Last updated: \today
        }%
    }%
}

\NewDocumentCommand{\Vectra@FooterPageText}{}{%
    \VectraFooterPagePrefix~\thepage\ \VectraFooterPageConnector~\pageref*{LastPage}%
}

\NewDocumentCommand{\VectraSetupFooter}{}{%
    \pagestyle{fancy}
    \fancyhf{}
    \ifdefstring{\Vectra@footerMode}{none}{%
        \fancyfoot{}%
    }{%
        \ifdefstring{\Vectra@footerMode}{simple}{%
            \fancyfoot[C]{\VectraFooterFont \Vectra@name}%
            \fancyfoot[R]{\VectraFooterFont \Vectra@FooterPageText}%
        }{%
            \fancyfoot[L]{\VectraFooterFont \Vectra@FooterDateText}%
            \fancyfoot[C]{\VectraFooterFont \Vectra@name}%
            \fancyfoot[R]{\VectraFooterFont \Vectra@FooterPageText}%
        }%
    }%
    \renewcommand{\headrulewidth}{0pt}
    \renewcommand{\footrulewidth}{0pt}
}

\AtBeginDocument{\VectraSetupFooter}

\endinput
